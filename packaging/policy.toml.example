# Example HKDFGuard policy. Installed by the packages as
# /usr/share/hkdfguard/policy.toml.example; nothing reads it there.
#
# To use it:
#   install -m 0644 -o root -g root /usr/share/hkdfguard/policy.toml.example \
#       /etc/hkdfguard/policy.toml
# then edit /etc/hkdfguard/policy.toml.
#
# As shipped -- every setting below commented out -- this file behaves
# exactly like having no policy file at all: providers are tried in the
# order tpm2, pkcs11, external-secret, and ephemeral is never used. Each
# commented line shows its default, or a placeholder where there is none;
# uncomment and change only what you need. See "Policy file reference" in
# the README (/usr/share/doc/libhkdfguard1/README.md on Debian and Ubuntu)
# for every setting.
#
# The policy must be owned by root and not writable by group or others, and
# so must /etc/hkdfguard and every directory above it -- sticky ones such as
# /tmp included: nothing the library reads (this file, the secrets, PIN and
# module it names) may live anywhere under /tmp, /var/tmp or /dev/shm. Only
# a read-only mount (a Kubernetes Secret or ConfigMap volume) is exempt.
# A file that exists
# but is wrongly owned, too broadly writable or malformed makes every
# operation fail closed; only a missing file means "no policy". Unknown
# keys are rejected, so a typo fails loudly rather than being ignored.
#
# The library re-reads this file on every call: changes take effect
# without restarting the service.

# The security model: "production" (the default, with or without this
# file) or "developer". Any other value -- "development" included -- makes
# the policy invalid. Production splits the duties:
#   security admin    root: `hkdfguard provision` and `retire`. The library
#                     creates a KEK that doesn't exist yet only for root;
#                     anyone else gets the existing one, or
#                     HKDFGUARD_ERR_KEK_ACCESS_DENIED (-18). An ephemeral
#                     KEK is exempt: it lives only in its own process.
#                     On TPM2 and PKCS#11 this is enforced directly;
#                     external-secret never creates a KEK.
#   deployment admin  root, or a deployer: `hkdfguard wrap`.
#   application       anyone else: unwraps, but cannot persist a key file
#                     hkdfguard_open_file would accept.
# hkdfguard_open_file trusts a key file, and each directory above it, only
# if root or a deployer owns it, and lets its group write it only if that
# group is a deployer group. Developer: anyone who can reach the provider
# may create a KEK, and key files owned by root or the calling user are
# trusted (no group may write them); reading one is audited (event 1005)
# once per process. Wrapping and unwrapping are the same in both models.
# Must stay above the first [table] header, or the file is rejected.
#security_model = "production"

# Under production, the deployers are the direct members of the group
# hkdfguard-deployers (the packages create it) and of each group named
# here: listed in the group's member list, or having it as their primary
# group. Names, not gids (an all-digit name is rejected), each listed once.
# A group that doesn't exist, can't be looked up, or is over-broad (root,
# users, nogroup, nobody, wheel, sudo, adm, staff, gid 0 or 65534) fails
# every key-file read with HKDFGUARD_ERR_LINUX_GROUP_INVALID (-80).
# Membership is looked up on every call (through NSS, so LDAP and sssd
# groups count): removing a deployer makes their key files untrusted at
# once. Ignored under developer. Must stay above the first [table] header.
#deployer_groups = ["payments-deployers"]

# Which providers may be used, and in what order, under mode = "prefer".
# A provider left out of the list is never used. This is also the only way
# to allow ephemeral (keys held in process memory, lost on restart): name
# it here. Must stay above the first [table] header, or the file is
# rejected.
#preferred_order = ["tpm2", "pkcs11", "external-secret"]

[selection]
# How a provider is chosen. The one required setting.
#   "prefer"         try preferred_order (or the default order) in turn;
#                    the first one available wins
#   "require"        only `provider`, never a fallback
#   "require-level"  any provider at `level` or above
mode = "prefer"
#provider = "tpm2"           # with "require": tpm2 | pkcs11 | external-secret | ephemeral
#level = "hardware"          # with "require-level": ephemeral | software | external | hardware

[key_requirements]
# Exclude every provider below this tier, whatever the mode:
#   ephemeral < software < external (secret files) < hardware (tpm2, pkcs11)
#minimum_protection = "external"

[startup_behavior]
# Floor on the duration of hkdfguard_create_kek and hkdfguard_kek_exists,
# in milliseconds, to limit how fast a caller can drive the TPM or HSM.
# 0 disables it; at most 60000.
#setup_min_delay_ms = 1000

[tpm]
# Which TPM: device:<path> | tabrmd:<conf>. mssim:<conf> and swtpm:<conf>
# are for test harnesses only.
#tcti = "device:/dev/tpmrm0"

# Directory of TPM key files: a <service>.tpmkey and its authValue,
# <service>.tpmauth, per service, created by `hkdfguard provision`. Whoever
# can read both files and open the TPM can use that KEK, so the directory's
# group is the services that use TPM keys; both files take that group, mode
# 0440. Give each .tpmauth file its own service's group to keep the others
# out. The packages create the default directory as root:hkdfguard 0750; a
# key_dir of your own needs
#   install -d -m 0750 -o root -g <key-users> <dir>
# Back both files up: losing either loses the KEK. A key file is useless on
# any other TPM; the .tpmauth file is a secret.
#key_dir = "/var/lib/hkdfguard/tpm"

# File holding the Owner hierarchy's password, if you set one. Unset: an
# empty password. Root-owned, mode 0400 (or 0440 with the service's group).
#owner_auth_file = "/etc/hkdfguard/tpm.owner-auth"

# true: only services listed in [tpm.pinned_names] have a KEK on the TPM,
# whatever key files exist. `hkdfguard provision -sn <service>` then
# creates the key file and prints the exact entry to add.
#require_pinned_names = false

# Encrypt each wrapping key (TPM2_HMAC's output) on the TPM bus, keyed by
# the service key's authValue: "on" (default) | "off" (test harnesses only).
#session_encryption = "on"
# The Name of the TPM's storage root key, which every key file is loaded
# under and provisioning's session is salted to. Pin it before provisioning
# on a discrete TPM.
#pinned_session_salt_key_name = "000b<64 hex chars>"

[tpm.pinned_names]
# The TPM Name each service's key must have; any other key is refused.
# Quote the service names: unquoted dots would make nested tables.
#"com.company.orders" = "000b<64 hex chars>"

[external_secret]
# Directory holding one KEK file per service, named after the service. It,
# and every directory above it, must be owned by root or the service's user
# and not writable by group or others (so never under /tmp), unless it is a
# read-only mount such as a Kubernetes Secret volume.
# When set, the only place looked. Unset: the first of these that exists:
#   /var/run/secrets/hkdfguard, /run/secrets/hkdfguard,
#   /vault/secrets/hkdfguard, /mnt/secrets-store/hkdfguard
#dir = "/run/secrets/hkdfguard"

[pkcs11]
# PKCS#11 is used only when `module` is set: there is no default module.
# The module and every directory above it must be root-owned and not
# writable by group or others (sticky ones such as /tmp included).
#module = "/usr/lib/vendor/libhsm-pkcs11.so"
# User PIN file: root-owned, mode 0400 (or 0440 with the service's group).
#pin_file = "/etc/hkdfguard/pkcs11.pin"
# Choose the token by label and/or serial; exactly one token must match.
# With neither, exactly one initialized token must be present.
#token_label = "hkdfguard-prod"
#token_serial = "0123456789abcdef"
