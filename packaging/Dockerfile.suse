# Builds the .rpm packages for SUSE Linux Enterprise Server 16 and openSUSE
# Leap 16.0 from the same spec as the dnf-based targets: see
# packaging/build-packages.sh, which passes BASE_IMAGE, pinned by digest,
# from its table of targets. SUSE's BCI base image stands in for SLES: its
# repository needs no subscription and carries the SLES 16 libraries. SLES
# 15 / Leap 15.6 are not targets: they ship tpm2-tss 3.1.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH

# BuildRequires come from the spec itself, so the two can't drift. zypper
# has no builddep for a spec file, so rpmspec lists them; each is passed as
# one capability ("pkgconfig(tss2-esys)>=4.0").
COPY packaging/rpm/hkdfguard.spec /tmp/hkdfguard.spec
RUN zypper --non-interactive install --no-recommends rpm-build util-linux tar gzip curl \
    && zypper --non-interactive install --no-recommends \
        $(rpmspec -q --buildrequires /tmp/hkdfguard.spec | tr -d ' ') \
    && zypper clean --all \
    && rm /tmp/hkdfguard.spec

# The toolchain pinned in rust-toolchain.toml, installed exactly as in
# docker/Dockerfile (see there for how to update the version and hashes;
# keep all four Dockerfiles in step). clippy is installed only because
# rust-toolchain.toml lists it: rustup would otherwise try to download it
# during the offline package build.
ARG RUSTUP_VERSION=1.29.1
RUN set -eu; \
    case "$(uname -m)" in \
        x86_64)  target=x86_64-unknown-linux-gnu;  sha256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71 ;; \
        aarch64) target=aarch64-unknown-linux-gnu; sha256=15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433 ;; \
        *) echo "no pinned rustup-init for $(uname -m)" >&2; exit 1 ;; \
    esac; \
    curl --proto '=https' --tlsv1.2 -sSfo /tmp/rustup-init \
        "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${target}/rustup-init"; \
    echo "${sha256}  /tmp/rustup-init" | sha256sum --check --strict -; \
    chmod 0755 /tmp/rustup-init; \
    /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain 1.98.1; \
    rm /tmp/rustup-init; \
    rustup component add clippy

# Packages are built as `builder`, not root.
RUN useradd --create-home builder \
    && chown -R builder:builder "$CARGO_HOME" \
    && install -d -o builder -g builder /build /build/hkdfguard

WORKDIR /build/hkdfguard
COPY --chown=builder:builder . /build/hkdfguard

ENTRYPOINT ["packaging/build-rpm.sh"]
