# Debian-family distribution test image (Debian, Ubuntu). One of the
# per-distro images docker/run-distro-tests.sh builds; see docker/README.md.
#
# BASE_IMAGE is always passed by run-distro-tests.sh, pinned by digest
# there; the default only keeps a bare `docker build` working.
ARG BASE_IMAGE=ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        softhsm2 \
    && rm -rf /var/lib/apt/lists/*

COPY docker/distros/prepare-image.sh /tmp/prepare-image.sh
RUN sh /tmp/prepare-image.sh && rm /tmp/prepare-image.sh
ENV SOFTHSM2_CONF=/etc/softhsm2-ci.conf \
    HKDFGUARD_TESTS_MUST_NOT_RUN_AS_ROOT=1

WORKDIR /work
COPY --chown=ci:ci . /work
ENTRYPOINT ["bash", "docker/distros/entrypoint-distro-test.sh"]
